# DefiSense Environment Configuration

# Google Gemini API Key (Optional: has local deterministic analytical fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Base Sepolia RPC
BASE_SEPOLIA_RPC=https://sepolia.base.org

# DefiSense Agent On-Chain Wallet (Base Sepolia testnet only)
AGENT_PRIVATE_KEY=your_testnet_private_key_here
AGENT_WALLET_ADDRESS=0x...

# Agent Backend URL
AGENT_BACKEND_URL=http://localhost:8000

